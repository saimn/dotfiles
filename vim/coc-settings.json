// vim: filetype=jsonc
{
  "clangd.arguments": ["--background-index", "--clang-tidy"],
  "extensions.updateCheck": "weekly",
  "git.addedSign.hlGroup": "GitGutterAdd",
  "git.changedSign.hlGroup": "GitGutterChange",
  "git.removedSign.hlGroup": "GitGutterDelete",
  "git.topRemovedSign.hlGroup": "GitGutterDelete",
  "git.changeRemovedSign.hlGroup": "GitGutterChangeDelete",
  "python.analysis.typeCheckingMode": "off",
  "python.formatting.provider": "ruff",
  "python.linting.flake8Enabled": false,
  "python.linting.ruffEnabled": true,
  "pyright.disableDiagnostics": true,
  "pyright.inlayHints.functionReturnTypes": false,
  "pyright.inlayHints.variableTypes": false,
  "pyright.inlayHints.parameterTypes": false,
  "pyright.organizeimports.provider": "ruff",
  "pyright.testing.provider": "pytest",
  "suggest.noselect": true,
  "snippets.ultisnips.pythonPrompt": false
}
  // "clangd.fallbackFlags": ["-std=c++23"],
  // "ruff.disableDocumentFormatting": true,
  // "semanticTokens.enable": true,
  // "suggest.enablePreselect": false,
